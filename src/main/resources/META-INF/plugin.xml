<idea-plugin>
    <id>org.clothfoundation.cloth.cloth-jetbrains</id>
    <name>Cloth</name>
    <vendor url="https://cloth.dev">Cloth Foundation</vendor>
    <description><![CDATA[
        Language support for Cloth, beginning with file recognition and syntax highlighting.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Cloth"
                  language="Cloth"
                  extensions="co;cloth;cl"
                  implementationClass="org.clothfoundation.cloth.ClothFileType"
                  fieldName="INSTANCE"/>
        <lang.syntaxHighlighterFactory language="Cloth"
                                       implementationClass="org.clothfoundation.cloth.highlighting.ClothSyntaxHighlighterFactory"/>
        <lang.commenter language="Cloth"
                        implementationClass="org.clothfoundation.cloth.editor.ClothCommenter"/>
        <lang.braceMatcher language="Cloth"
                           implementationClass="org.clothfoundation.cloth.editor.ClothBraceMatcher"/>
        <lang.quoteHandler language="Cloth"
                           implementationClass="org.clothfoundation.cloth.editor.ClothQuoteHandler"/>
        <colorSettingsPage implementation="org.clothfoundation.cloth.highlighting.ClothColorSettingsPage"/>
        <fileIconProvider implementation="org.clothfoundation.cloth.icons.ClothFileIconProvider"/>
        <projectViewNodeDecorator implementation="org.clothfoundation.cloth.projectview.ClothSourceFolderDecorator"/>
    </extensions>
</idea-plugin>
